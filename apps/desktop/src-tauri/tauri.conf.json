{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orion",
  "version": "0.1.0",
  "identifier": "dev.orion.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Orion · 磁盘空间", "width": 1280, "height": 840, "minWidth": 960, "minHeight": 640 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": { "active": false }
}
